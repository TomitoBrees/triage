{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"ioa-dashboard": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"index": "src/index.html",
						"styles": ["src/styles.css"]
					},
					"configurations": {
						"production": {
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "ioa-dashboard:build:production"
						},
						"development": {
							"buildTarget": "ioa-dashboard:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		}
  },
  "cli": {
    "analytics": "53b8e5fd-027e-4b83-9c69-98741d6c1dea"
  }
}
